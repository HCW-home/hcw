#: core/settings.py:869
msgid ""
"When to send first appointment reminder, in minute before the appointment "
"time"
msgstr ""
"Quand envoyer le premier rappel de rendez-vous, en minutes avant l'heure du "
"rendez-vous"

#: core/settings.py:875
msgid ""
"When to send last appointment reminder, in minute before the appointment "
"time"
msgstr ""
"Quand envoyer le dernier rappel de rendez-vous, en minutes avant l'heure du "
"rendez-vous"

#: core/settings.py:881
msgid "Minutes before appointment scheduled time that participants can join"
msgstr ""
"Nombre de minutes avant l'heure prévue du rendez-vous pendant lesquelles les"
" participants peuvent rejoindre l'appel"

#: core/settings.py:887
msgid ""
"Minutes after the expected end of the appointment during which participants "
"can still rejoin the call"
msgstr ""
"Nombre de minutes après la fin prévue du rendez-vous pendant lesquelles les "
"participants peuvent encore rejoindre l'appel"

#: core/settings.py:893
msgid ""
"Default duration in minutes for an appointment without an explicit end time"
msgstr ""
"Durée par défaut en minutes d'un rendez-vous sans heure de fin explicite"

#: core/settings.py:899
msgid ""
"Hours after closure before a follow-up is automatically deleted (0 to "
"disable)"
msgstr ""
"Nombre d'heures après la clôture avant la suppression automatique d'un suivi"
" (0 pour désactiver)"

#: core/settings.py:905
#| msgid ""
#| "Auto-created for an online Appointment without explicit consultation; hidden"
#| " from practitioner and patient lists, auto-closed once the appointment join "
#| "window has elapsed."
msgid ""
"Automatically close temporary appointment-chat consultations once the "
"appointment join window has elapsed"
msgstr ""
"Clôturer automatiquement les consultations temporaires de discussion de "
"rendez-vous une fois la fenêtre de connexion au rendez-vous écoulée"

#: core/settings.py:910
msgid "Automatically delete temporary users with no future appointments"
msgstr ""
"Supprimer automatiquement les utilisateurs temporaires sans rendez-vous "
"futur"

#: core/settings.py:914
msgid "Hours before a temporary participant access token expires"
msgstr ""
"Nombre d'heures avant l'expiration du jeton d'accès d'un participant "
"temporaire"

#: core/settings.py:918
msgid "Disable password login for practitioners (SSO only)"
msgstr ""
"Désactiver la connexion par mot de passe pour les praticiens (SSO "
"uniquement)"

#: core/settings.py:923
msgid ""
"Allow patients to log in with a password on the patient app; when off, "
"patients authenticate with an email/SMS code instead. Practitioners and "
"admins can always use password login."
msgstr ""
"Autoriser les patients à se connecter avec un mot de passe sur l'application"
" patient ; si désactivé, les patients s'authentifient avec un code envoyé "
"par e-mail/SMS. Les praticiens et les administrateurs peuvent toujours "
"utiliser la connexion par mot de passe."

#: core/settings.py:928
msgid "Enable self-registration for new users"
msgstr "Activer l'inscription libre des nouveaux utilisateurs"

#: core/settings.py:932
msgid "Maximum file upload size in MB (0 to disable limit)"
msgstr ""
"Taille maximale des fichiers téléversés en Mo (0 pour désactiver la limite)"

#: core/settings.py:937
msgid ""
"Controls which users practitioners can see: all = all users, alone = no "
"sharing, alone, organization = same organization practitioners"
msgstr ""
"Détermine quels utilisateurs les praticiens peuvent voir : all = tous les "
"utilisateurs, alone = aucun partage, organization = les praticiens de la "
"même organisation"

#: core/settings.py:944
msgid ""
"Controls which patients practitioners can see: all = all patients, alone = "
"only patients they created, organization = patients from same organization"
msgstr ""
"Détermine quels patients les praticiens peuvent voir : all = tous les "
"patients, alone = uniquement les patients qu'ils ont créés, organization = "
"les patients de la même organisation"

#: core/settings.py:950
msgid "Enable video recording during appointments"
msgstr "Activer l'enregistrement vidéo pendant les rendez-vous"

#: core/settings.py:955
msgid ""
"Enable live transcription and subtitles during appointments (requires "
"whisper-live server)"
msgstr ""
"Activer la transcription en direct et les sous-titres pendant les rendez-"
"vous (nécessite un serveur whisper-live)"

#: core/settings.py:961
msgid ""
"Whisper model to use for transcription (tiny, base, small, medium, large-v3)"
msgstr ""
"Modèle Whisper à utiliser pour la transcription (tiny, base, small, medium, "
"large-v3)"

#: core/settings.py:968
msgid ""
"Allow unauthenticated access to the organisations and reasons endpoints"
msgstr ""
"Autoriser l'accès non authentifié aux points d'accès des organisations et "
"des motifs"

#: core/settings.py:974
msgid ""
"Force all newly created patients to be temporary users (no permanent patient"
" accounts)"
msgstr ""
"Forcer tous les patients nouvellement créés à être des utilisateurs "
"temporaires (aucun compte patient permanent)"

#: core/settings.py:980
msgid ""
"Default media server provider for video calls; used by frontends to lazy-"
"prefetch the matching SDK"
msgstr ""
"Fournisseur de serveur média par défaut pour les appels vidéo ; utilisé par "
"les frontends pour précharger le SDK correspondant"

#: core/settings.py:987
msgid "Global toggle for end-to-end encryption of consultations and messages"
msgstr ""
"Interrupteur global du chiffrement de bout en bout des consultations et des "
"messages"

#: core/settings.py:993
msgid ""
"PEM-encoded SPKI master public key (recovery). Set via the Encryption admin "
"page."
msgstr ""
"Clé publique maître SPKI encodée en PEM (récupération). À définir depuis la "
"page d'administration Chiffrement."

#: core/settings.py:999
msgid "SHA-256 hex fingerprint of the master public key (display only)"
msgstr ""
"Empreinte hexadécimale SHA-256 de la clé publique maître (affichage seul)"

#: core/settings.py:1005
msgid ""
"Platform certification blob (JSON) authorizing this host for the native app."
" Get certificated on https://hcw-at-home.com/get-certificate/."
msgstr ""
"Bloc de certification de la plateforme (JSON) autorisant cet hôte pour "
"l'application native. Obtenez un certificat sur https://hcw-at-home.com/get-"
"certificate/."

#: core/settings.py:1012
msgid ""
"Show a banner on the patient web home inviting users to open the native app."
msgstr ""
"Afficher une bannière sur l'accueil web patient invitant les utilisateurs à "
"ouvrir l'application native."

#: core/settings.py:1019
msgid ""
"Require the native mobile app: block the patient web app for this tenant and"
" prompt users to open or install the mobile app instead. Disabled by "
"default."
msgstr ""
"Imposer l'application mobile native : bloquer l'application web patient pour"
" ce locataire et inviter les utilisateurs à ouvrir ou installer "
"l'application mobile. Désactivé par défaut."

#: core/settings.py:1028
msgid ""
"Android applicationId of the native patient app. Defaults to the "
"MOBILE_ANDROID_PACKAGE env var; override per instance if needed."
msgstr ""
"applicationId Android de l'application patient native. Par défaut, la "
"variable d'environnement MOBILE_ANDROID_PACKAGE ; à surcharger par instance "
"si nécessaire."

#: core/settings.py:1035
msgid ""
"Play Store URL the web 'open in app' banner falls back to when the app is "
"not installed. Defaults to the MOBILE_ANDROID_STORE_URL env var."
msgstr ""
"URL du Play Store vers laquelle la bannière web « ouvrir dans l'application "
"» redirige lorsque l'application n'est pas installée. Par défaut, la "
"variable d'environnement MOBILE_ANDROID_STORE_URL."

#: core/settings.py:1042
msgid ""
"App Store URL the web 'open in app' banner falls back to on iOS when the app"
" is not installed. Defaults to the MOBILE_IOS_STORE_URL env var. Leave blank"
" to disable the iOS store fallback."
msgstr ""
"URL de l'App Store vers laquelle la bannière web « ouvrir dans l'application"
" » redirige sur iOS lorsque l'application n'est pas installée. Par défaut, "
"la variable d'environnement MOBILE_IOS_STORE_URL. Laisser vide pour "
"désactiver le repli vers l'App Store iOS."

#: core/settings.py:1050
msgid ""
"FHIR Identifier.system URL of the external partner for Appointment "
"resources. Identifiers under this system populate Appointment.external_id. "
"Replace the example value with the actual URL of your integration partner. "
"Leave blank to disable external-identifier handling for Appointment."
msgstr ""
"URL FHIR Identifier.system du partenaire externe pour les ressources "
"Appointment. Les identifiants relevant de ce système alimentent "
"Appointment.external_id. Remplacez la valeur d'exemple par l'URL réelle de "
"votre partenaire d'intégration. Laisser vide pour désactiver la gestion des "
"identifiants externes pour Appointment."

#: core/settings.py:1059
msgid ""
"FHIR Identifier.system URL of the external partner for Encounter resources "
"(Consultation in HCW). Leave blank to disable."
msgstr ""
"URL FHIR Identifier.system du partenaire externe pour les ressources "
"Encounter (Consultation dans HCW). Laisser vide pour désactiver."

#: core/settings.py:1066
msgid ""
"FHIR Identifier.system URL of the external partner for Patient resources. "
"Leave blank to disable."
msgstr ""
"URL FHIR Identifier.system du partenaire externe pour les ressources "
"Patient. Laisser vide pour désactiver."

#: core/settings.py:1073
msgid ""
"FHIR Identifier.system URL of the external partner for Practitioner "
"resources. Leave blank to disable."
msgstr ""
"URL FHIR Identifier.system du partenaire externe pour les ressources "
"Practitioner. Laisser vide pour désactiver."

#: core/settings.py:1080
msgid ""
"FHIR Identifier.system URL of the external partner for MedicationRequest "
"resources (Prescription in HCW). Leave blank to disable."
msgstr ""
"URL FHIR Identifier.system du partenaire externe pour les ressources "
"MedicationRequest (Prescription dans HCW). Laisser vide pour désactiver."

#: core/settings.py:1087
msgid ""
"Colorize the calendar background in the practitioner view using a rotating "
"4-week palette. Disabled by default."
msgstr ""
"Colorer l'arrière-plan du calendrier dans la vue praticien à l'aide d'une "
"palette tournante sur 4 semaines. Désactivé par défaut."

#: core/settings.py:1094
msgid "Calendar background color for week 1 of the 4-week rotation (hex)."
msgstr ""
"Couleur d'arrière-plan du calendrier pour la semaine 1 de la rotation de 4 "
"semaines (hex)."

#: core/settings.py:1101
msgid "Calendar background color for week 2 of the 4-week rotation (hex)."
msgstr ""
"Couleur d'arrière-plan du calendrier pour la semaine 2 de la rotation de 4 "
"semaines (hex)."

#: core/settings.py:1108
msgid "Calendar background color for week 3 of the 4-week rotation (hex)."
msgstr ""
"Couleur d'arrière-plan du calendrier pour la semaine 3 de la rotation de 4 "
"semaines (hex)."

#: core/settings.py:1115
msgid "Calendar background color for week 4 of the 4-week rotation (hex)."
msgstr ""
"Couleur d'arrière-plan du calendrier pour la semaine 4 de la rotation de 4 "
"semaines (hex)."

#: core/settings.py:1122
msgid ""
"Anchor date (YYYY-MM-DD) for the continuous week counter. The week "
"containing this date is week 1 of the rotation. The counter never resets, so"
" colors stay consistent across year boundaries."
msgstr ""
"Date d'ancrage (AAAA-MM-JJ) du compteur de semaines continu. La semaine "
"contenant cette date est la semaine 1 de la rotation. Le compteur ne se "
"réinitialise jamais, les couleurs restent donc cohérentes d'une année à "
"l'autre."

#: core/settings.py:1130
msgid ""
"First day of the week shown in the practitioner calendars (0 = Sunday, 1 = "
"Monday)."
msgstr ""
"Premier jour de la semaine affiché dans les calendriers des praticiens (0 = "
"dimanche, 1 = lundi)."

#: core/settings.py:1138
msgid ""
"How the organisation logo is included in emails: 'embed' attaches it inline "
"(Content-ID, always displayed) or 'url' links to the media file (lighter, "
"but many clients block remote images by default)."
msgstr ""
"Mode d'inclusion du logo de l'organisation dans les e-mails : « embed » "
"l'attache en ligne (Content-ID, toujours affiché) ou « url » pointe vers le "
"fichier média (plus léger, mais de nombreux clients bloquent les images "
"distantes par défaut)."

#: core/settings.py:1147
msgid ""
"Absolute base URL used to build the logo link when email_logo_mode is 'url' "
"and media is stored locally (e.g. https://patient.example.com). Leave empty "
"to fall back to patient_base_url. Ignored for S3 storage, which already "
"returns absolute URLs."
msgstr ""
"URL de base absolue utilisée pour construire le lien du logo lorsque "
"email_logo_mode vaut « url » et que les médias sont stockés localement (par "
"ex. https://patient.example.com). Laisser vide pour se replier sur "
"patient_base_url. Ignoré pour le stockage S3, qui renvoie déjà des URL "
"absolues."

