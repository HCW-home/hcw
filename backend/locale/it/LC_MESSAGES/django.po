#: users/admin.py:121
#, python-format
msgid ""
"The last reminder is sent %(reminder)s minutes before the appointment, but "
"participants can only join %(join)s minutes before it starts. It is "
"recommended to allow joining the call as soon as the last reminder is "
"received: set 'appointment_early_join_minutes' to at least %(reminder)s "
"minutes."
msgstr ""
"L'ultimo promemoria viene inviato %(reminder)s minuti prima "
"dell'appuntamento, ma i partecipanti possono accedere solo %(join)s minuti "
"prima dell'inizio. Si consiglia di consentire l'accesso alla chiamata appena"
" ricevuto l'ultimo promemoria: impostare «appointment_early_join_minutes» ad"
" almeno %(reminder)s minuti."

